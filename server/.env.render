# ============================================================
#  SmartHostel — Render Production Environment Variables
#  Copy these into your Render service's Environment section
# ============================================================

NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────
# Auto-set by Render when you link the PostgreSQL database
DATABASE_URL=postgresql://user:pass@host/hostel_db

# ── JWT (Render can auto-generate these — use generateValue) ──
JWT_SECRET=generate-a-strong-random-secret-here
JWT_REFRESH_SECRET=generate-another-strong-random-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────
# Leave EMPTY on Render free tier (app works without Redis)
# Or set to Upstash Redis URL: rediss://user:pass@host:port
REDIS_URL=

# ── CORS ──────────────────────────────────────────────────
# Allow all origins (Render frontend URLs auto-allowed)
CLIENT_URL=*

# ── QR Attendance ─────────────────────────────────────────
QR_SECRET=generate-a-random-qr-secret-here

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Razorpay (Payment Gateway) ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_SxZOeiPTiif2Nd
RAZORPAY_KEY_SECRET=Hv4Jdr7gtZjrNnmpY3mzwvag

# ── AI Service URL ────────────────────────────────────────
# Set to your Render AI service URL after deploying it
AI_SERVICE_URL=https://smarthostel-ai.onrender.com

# ── Email (optional) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@smarthostel.edu
