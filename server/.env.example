# SmartHostel — Server Environment Variables
# Copy this to .env and fill in your values

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/hostel_db

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-32-char-random
JWT_REFRESH_SECRET=change-me-refresh-use-32-char-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (optional but recommended) ──────────────────────────
# Leave blank to disable token blacklist + caching
REDIS_URL=redis://localhost:6379

# ── Email SMTP ─────────────────────────────────────────────────
# SendGrid: SMTP_USER=apikey, SMTP_PASS=your-sendgrid-api-key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
FROM_EMAIL=noreply@smarthostel.edu
APP_URL=http://localhost:5173

# ── Frontend URL ───────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Google OAuth ───────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
