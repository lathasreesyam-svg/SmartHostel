# ========================
# AI SERVICE ENVIRONMENT
# ========================

# Mode: "mock" uses built-in rule-based responses (no API key needed)
# Set to "openai" or "gemini" for real AI responses
AI_MODE=mock

# OpenAI (only needed if AI_MODE=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Gemini (only needed if AI_MODE=gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Server
PORT=8000
