# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/

# Environment files
.env.local
.env.*.local
# Allow server/.env (contains only demo/test keys - safe to commit)
!server/.env
# Ignore root and client env files
client/.env
client/.env.*

# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Docker volumes (not files, but just in case)
postgres_data/
redis_data/

# Temporary
*.tmp
*.temp
